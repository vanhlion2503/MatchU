rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= DEFAULT DENY =================
    match /{document=**} {
      allow read, write: if false;
    }

    function postVisibility(data) {
      return data.visibility is string
        ? data.visibility
        : (data.isPublic == true ? "public" : "private");
    }

    function postModerationStatus(data) {
      return data.moderationStatus is string
        ? data.moderationStatus
        : "approved";
    }

    function isValidPostVisibilityValue(value) {
      return value in ["public", "followers", "private"];
    }

    function isValidPostModerationStatusValue(value) {
      return value in [
        "pending_moderation",
        "approved",
        "rejected",
        "review_required"
      ];
    }

    function hasValidPostVisibilityForWrite(data) {
      return (
        !("visibility" in data)
        && data.isPublic is bool
      ) || (
        data.visibility is string
        && isValidPostVisibilityValue(data.visibility)
        && data.isPublic is bool
        && (
          (data.visibility == "public" && data.isPublic == true)
          || (data.visibility != "public" && data.isPublic == false)
        )
      );
    }

    function hasValidRequestedPostVisibilityForWrite(data) {
      return !("requestedVisibility" in data)
        || data.requestedVisibility == null
        || (
          data.requestedVisibility is string
          && isValidPostVisibilityValue(data.requestedVisibility)
        );
    }

    function hasValidPostModerationForWrite(data) {
      let status = postModerationStatus(data);
      return isValidPostModerationStatusValue(status)
        && hasValidRequestedPostVisibilityForWrite(data)
        && (
          status != "pending_moderation"
          || (
            postVisibility(data) == "private"
            && data.isPublic == false
            && data.requestedVisibility is string
            && isValidPostVisibilityValue(data.requestedVisibility)
          )
        );
    }

    function hasValidPostModerationForCreate(data) {
      let status = postModerationStatus(data);
      return hasValidPostModerationForWrite(data)
        && status in ["approved", "pending_moderation"];
    }

    function isPostPublic(data) {
      return postVisibility(data) == "public";
    }

    function isPostFollowersOnly(data) {
      return postVisibility(data) == "followers";
    }

    function isFollowerOf(authorId) {
      return request.auth != null
        && authorId is string
        && exists(/databases/$(database)/documents/users/$(authorId))
        && get(/databases/$(database)/documents/users/$(authorId)).data.followers is list
        && request.auth.uid in
          get(/databases/$(database)/documents/users/$(authorId)).data.followers;
    }

    function canAccessPostData(data) {
      return isPostPublic(data)
        || (
          request.auth != null
          && data.authorId == request.auth.uid
        )
        || (
          isPostFollowersOnly(data)
          && isFollowerOf(data.authorId)
        );
    }

    function isBlockedBetween(userA, userB) {
      return userA is string
        && userB is string
        && userA != userB
        && (
          exists(/databases/$(database)/documents/users/$(userA)/blockedUsers/$(userB))
          || exists(/databases/$(database)/documents/users/$(userB)/blockedUsers/$(userA))
        );
    }

    function hasTwoDistinctParticipants(data) {
      return data.participants is list
        && data.participants.size() == 2
        && data.participants[0] is string
        && data.participants[1] is string
        && data.participants[0] != data.participants[1];
    }

    function participantsHaveNoBlock(data) {
      return hasTwoDistinctParticipants(data)
        && !isBlockedBetween(data.participants[0], data.participants[1]);
    }

    function canUseAccountFeature(feature) {
      let signedIn = request.auth != null;
      let userExists = signedIn
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      let user = userExists
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
      let status = userExists && user.accountStatus is string
        ? user.accountStatus
        : "active";
      let hasRestriction = userExists
        && user.restriction is map
        && user.restriction.features is list;
      let restrictionExpired = hasRestriction
        && user.restriction.expiresAt is timestamp
        && request.time >= user.restriction.expiresAt;
      let suspensionExpired = userExists
        && user.suspension is map
        && user.suspension.expiresAt is timestamp
        && request.time >= user.suspension.expiresAt;
      return userExists
        && (
          status == "active"
          || (status == "suspended" && suspensionExpired)
          || (
            status == "restricted"
            && hasRestriction
            && (
              restrictionExpired
              || !(feature in user.restriction.features)
            )
          )
        );
    }

    // ================= USERS =================
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && request.auth.uid == userId;
      }

      function followersBefore() {
        return resource.data.followers is list
          ? resource.data.followers
          : [];
      }

      function followersAfter() {
        return request.resource.data.followers is list
          ? request.resource.data.followers
          : [];
      }

      function followingBefore() {
        return resource.data.following is list
          ? resource.data.following
          : [];
      }

      function followingAfter() {
        return request.resource.data.following is list
          ? request.resource.data.following
          : [];
      }

      function isAddSelfFollower() {
        return !(request.auth.uid in followersBefore())
          && request.auth.uid in followersAfter()
          && followersAfter().size() == followersBefore().size() + 1;
      }

      function isRemoveSelfFollower() {
        return request.auth.uid in followersBefore()
          && !(request.auth.uid in followersAfter())
          && followersAfter().size() + 1 == followersBefore().size();
      }

      function isRemoveSelfFollowing() {
        return request.auth.uid in followingBefore()
          && !(request.auth.uid in followingAfter())
          && followingAfter().size() + 1 == followingBefore().size();
      }

      function isFollowersOnlyUpdate() {
        return request.auth != null
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["followers"])
          && (isAddSelfFollower() || isRemoveSelfFollower());
      }

      function isSocialConnectionCleanupUpdate() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return request.auth != null
          && changed.hasOnly(["followers", "following"])
          && changed.hasAny(["followers", "following"])
          && (!changed.hasAny(["followers"]) || isRemoveSelfFollower())
          && (!changed.hasAny(["following"]) || isRemoveSelfFollowing());
      }

      function isRatingOnlyUpdate() {
        let oldTotal = resource.data.totalChatRatings is int
          ? resource.data.totalChatRatings
          : (resource.data.totalChatRatings is number
            ? resource.data.totalChatRatings
            : 0);

        return request.auth != null
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["avgChatRating", "totalChatRatings"])
          && request.resource.data.totalChatRatings is number
          && request.resource.data.totalChatRatings == oldTotal + 1
          && request.resource.data.avgChatRating is number
          && request.resource.data.avgChatRating >= 0
          && request.resource.data.avgChatRating <= 5;
      }

      function isReportOnlyUpdate() {
        let oldTotal = resource.data.totalReports is int
          ? resource.data.totalReports
          : (resource.data.totalReports is number
            ? resource.data.totalReports
            : 0);

        return request.auth != null
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["totalReports"])
          && request.resource.data.totalReports is number
          && request.resource.data.totalReports == oldTotal + 1;
      }

      function touchesServerManagedReputationFields() {
        return request.resource.data.diff(resource.data).changedKeys().hasAny([
          "reputation",
          "reputationScore",
          "reputationTodayDateKey",
          "reputationTodayClaimed",
          "reputationTodayCap",
          "reputationLastClaimAt"
        ]);
      }

      function touchesServerManagedFaceVerificationFields() {
        return request.resource.data.diff(resource.data).changedKeys().hasAny([
          "isFaceVerified",
          "faceVerifiedAt",
          "faceVerificationVersion",
          "faceEnrollmentId"
        ]);
      }

      function touchesServerManagedGemField() {
        return request.resource.data.diff(resource.data).changedKeys().hasAny([
          "gem"
        ]);
      }

      function hasValidGemCreateDefault() {
        return request.resource.data.gem is int
          && request.resource.data.gem == 15;
      }

      function touchesServerManagedRecommendationFields() {
        return request.resource.data.diff(resource.data).changedKeys().hasAny([
          "interestVector",
          "interestWeight",
          "effectiveCount",
          "interestEmbeddingModel",
          "interestVectorDimensions",
          "interestUpdatedAt",
          "recommendationCacheInvalidatedAt"
        ]);
      }

      function isValidReputationCreateDefaults() {
        return (
          !("reputation" in request.resource.data)
          || (
            request.resource.data.reputation is number
            && request.resource.data.reputation >= 0
            && request.resource.data.reputation <= 100
          )
        )
        && (
          !("reputationScore" in request.resource.data)
          || (
            request.resource.data.reputationScore is number
            && request.resource.data.reputationScore >= 0
            && request.resource.data.reputationScore <= 100
          )
        )
        && (
          !("reputationTodayDateKey" in request.resource.data)
          || request.resource.data.reputationTodayDateKey == null
        )
        && (
          !("reputationTodayClaimed" in request.resource.data)
          || request.resource.data.reputationTodayClaimed == 0
        )
        && (
          !("reputationTodayCap" in request.resource.data)
          || request.resource.data.reputationTodayCap == 10
        )
        && (
          !("reputationLastClaimAt" in request.resource.data)
          || request.resource.data.reputationLastClaimAt == null
        );
      }

      function isValidFaceVerificationCreateDefaults() {
        return (
          !("isFaceVerified" in request.resource.data)
          || request.resource.data.isFaceVerified == false
        )
        && (
          !("faceVerifiedAt" in request.resource.data)
          || request.resource.data.faceVerifiedAt == null
        )
        && (
          !("faceVerificationVersion" in request.resource.data)
          || request.resource.data.faceVerificationVersion == null
        )
        && (
          !("faceEnrollmentId" in request.resource.data)
          || request.resource.data.faceEnrollmentId == null
        );
      }

      function isValidRecommendationCreateDefaults() {
        return (
          !("interestVector" in request.resource.data)
          || (
            request.resource.data.interestVector is list
            && request.resource.data.interestVector.size() == 0
          )
        )
        && (
          !("interestWeight" in request.resource.data)
          || request.resource.data.interestWeight == 0
        )
        && (
          !("effectiveCount" in request.resource.data)
          || request.resource.data.effectiveCount == 0
        )
        && (
          !("interestEmbeddingModel" in request.resource.data)
          || request.resource.data.interestEmbeddingModel == null
        )
        && (
          !("interestVectorDimensions" in request.resource.data)
          || request.resource.data.interestVectorDimensions == 0
        )
        && (
          !("interestUpdatedAt" in request.resource.data)
          || request.resource.data.interestUpdatedAt == null
        )
        && (
          !("recommendationCacheInvalidatedAt" in request.resource.data)
          || request.resource.data.recommendationCacheInvalidatedAt == null
        );
      }

      function isOwnerSafeCreate() {
        return isOwner()
          && hasValidGemCreateDefault()
          && isValidReputationCreateDefaults()
          && isValidFaceVerificationCreateDefaults()
          && isValidRecommendationCreateDefaults()
          && hasValidProfilePrivacySettings();
      }

      function hasValidProfilePrivacySettings() {
        return (
          !("followingListVisibility" in request.resource.data)
          || request.resource.data.followingListVisibility in [
            "everyone",
            "followers",
            "only_me"
          ]
        )
        && (
          !("isPrivateAccount" in request.resource.data)
          || request.resource.data.isPrivateAccount is bool
        );
      }

      function isOwnerSafeUpdate() {
        return isOwner()
          && !touchesServerManagedGemField()
          && !touchesServerManagedReputationFields()
          && !touchesServerManagedFaceVerificationFields()
          && !touchesServerManagedRecommendationFields()
          && hasValidProfilePrivacySettings();
      }

      allow read: if isSignedIn();
      allow create: if isOwnerSafeCreate();
      allow update: if isOwnerSafeUpdate()
        || isFollowersOnlyUpdate()
        || isSocialConnectionCleanupUpdate()
        || isRatingOnlyUpdate()
        || isReportOnlyUpdate();
      allow delete: if false;
      
      match /devices/{deviceId} {

        // Device documents are a public E2EE directory. Push credentials live
        // in notificationDevices and must never be readable by another user.
        allow read: if request.auth != null
          && (
            request.auth.uid == userId
            || !resource.data.keys().hasAny([
              "fcmToken",
              "fcmTokenUpdatedAt",
              "pushEnabled",
              "notificationPermission",
              "notificationUpdatedAt",
              "lastNotificationOpenedAt"
            ])
          );

        function isOwnerDeviceWrite() {
          return request.auth != null && request.auth.uid == userId;
        }

        function hasOnlyAllowedDeviceKeys() {
          return request.resource.data.keys().hasOnly([
            "publicKey",
            "algorithm",
            "platform",
            "createdAt",
            "lastActiveAt",
            "e2eeStatus",
            "lastE2eeActiveAt",
            "e2eeUpdatedAt",
            "signedOutAt",
            "revokedAt",
            "fcmToken",
            "fcmTokenUpdatedAt",
            "pushEnabled",
            "notificationPermission",
            "notificationUpdatedAt",
            "lastNotificationOpenedAt"
          ]);
        }

        function hasValidDeviceFieldTypes() {
          return (
            !("publicKey" in request.resource.data)
            || request.resource.data.publicKey is string
          )
          && (
            !("algorithm" in request.resource.data)
            || request.resource.data.algorithm == "RSA-2048"
          )
          && (
            !("platform" in request.resource.data)
            || request.resource.data.platform is string
          )
          && (
            !("createdAt" in request.resource.data)
            || request.resource.data.createdAt is timestamp
          )
          && (
            !("lastActiveAt" in request.resource.data)
            || request.resource.data.lastActiveAt is timestamp
          )
          && (
            !("e2eeStatus" in request.resource.data)
            || request.resource.data.e2eeStatus in [
              "active",
              "inactive",
              "revoked",
              "stale"
            ]
          )
          && (
            !("lastE2eeActiveAt" in request.resource.data)
            || request.resource.data.lastE2eeActiveAt is timestamp
          )
          && (
            !("e2eeUpdatedAt" in request.resource.data)
            || request.resource.data.e2eeUpdatedAt is timestamp
          )
          && (
            !("signedOutAt" in request.resource.data)
            || request.resource.data.signedOutAt is timestamp
          )
          && (
            !("revokedAt" in request.resource.data)
            || request.resource.data.revokedAt is timestamp
          )
          && (
            !("fcmToken" in request.resource.data)
            || request.resource.data.fcmToken is string
          )
          && (
            !("fcmTokenUpdatedAt" in request.resource.data)
            || request.resource.data.fcmTokenUpdatedAt is timestamp
          )
          && (
            !("pushEnabled" in request.resource.data)
            || request.resource.data.pushEnabled is bool
          )
          && (
            !("notificationPermission" in request.resource.data)
            || request.resource.data.notificationPermission is string
          )
          && (
            !("notificationUpdatedAt" in request.resource.data)
            || request.resource.data.notificationUpdatedAt is timestamp
          )
          && (
            !("lastNotificationOpenedAt" in request.resource.data)
            || request.resource.data.lastNotificationOpenedAt is timestamp
          );
        }

        allow create: if isOwnerDeviceWrite()
          && hasOnlyAllowedDeviceKeys()
          && hasValidDeviceFieldTypes();

        allow update: if isOwnerDeviceWrite()
          && hasOnlyAllowedDeviceKeys()
          && hasValidDeviceFieldTypes();

        allow delete: if isOwnerDeviceWrite();
      }

      match /notificationDevices/{deviceId} {
        function isOwnerNotificationDevice() {
          return request.auth != null && request.auth.uid == userId;
        }

        function hasOnlyNotificationDeviceKeys() {
          return request.resource.data.keys().hasOnly([
            "platform",
            "appVersion",
            "buildNumber",
            "locale",
            "status",
            "lastActiveAt",
            "fcmToken",
            "fcmTokenUpdatedAt",
            "pushEnabled",
            "notificationPermission",
            "notificationUpdatedAt",
            "lastNotificationOpenedAt"
          ]);
        }

        function hasValidNotificationDeviceTypes() {
          return request.resource.data.platform is string
            && (
              !("appVersion" in request.resource.data)
              || request.resource.data.appVersion is string
            )
            && (
              !("buildNumber" in request.resource.data)
              || request.resource.data.buildNumber is string
            )
            && (
              !("locale" in request.resource.data)
              || request.resource.data.locale is string
            )
            && request.resource.data.status in [
              "active",
              "inactive",
              "revoked",
              "stale"
            ]
            && request.resource.data.lastActiveAt is timestamp
            && request.resource.data.pushEnabled is bool
            && request.resource.data.notificationPermission in [
              "authorized",
              "denied",
              "provisional",
              "not_determined"
            ]
            && request.resource.data.notificationUpdatedAt is timestamp
            && (
              !("fcmToken" in request.resource.data)
              || request.resource.data.fcmToken is string
            )
            && (
              !("fcmTokenUpdatedAt" in request.resource.data)
              || request.resource.data.fcmTokenUpdatedAt is timestamp
            )
            && (
              !("lastNotificationOpenedAt" in request.resource.data)
              || request.resource.data.lastNotificationOpenedAt is timestamp
            );
        }

        allow read, delete: if isOwnerNotificationDevice();
        allow create, update: if isOwnerNotificationDevice()
          && hasOnlyNotificationDeviceKeys()
          && hasValidNotificationDeviceTypes();
      }

    }

    match /users/{userId}/savedPosts/{postId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function targetPostExists() {
        return exists(/databases/$(database)/documents/posts/$(postId));
      }

      function targetPost() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }

      function canAccessTargetPost() {
        return targetPostExists()
          && canAccessPostData(targetPost());
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && canAccessTargetPost()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId;
      allow update: if isOwner()
        && canAccessTargetPost()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId;
      allow delete: if isOwner();
    }

    match /users/{userId}/notifications/{notificationId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isReadStateOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["readAt"])
          && (
            request.resource.data.readAt is timestamp
            || request.resource.data.readAt == null
          );
      }

      allow get, list: if isOwner();
      allow update: if isOwner() && isReadStateOnlyUpdate();
      allow create: if false;
      allow delete: if isOwner();
    }

    match /users/{userId}/mutedNotificationAuthors/{authorId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidMutedNotificationAuthorData() {
        return request.resource.data.keys().hasOnly([
          "userId",
          "authorId",
          "displayName",
          "nickname",
          "avatarUrl",
          "sourceNotificationId",
          "mutedAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.authorId == authorId
        && request.resource.data.authorId != userId
        && request.resource.data.displayName is string
        && request.resource.data.nickname is string
        && request.resource.data.avatarUrl is string
        && request.resource.data.sourceNotificationId is string
        && request.resource.data.mutedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasValidMutedNotificationAuthorData();
      allow delete: if isOwner();
    }

    match /users/{userId}/mutedChatUsers/{mutedUserId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidMutedChatUserData() {
        return request.resource.data.keys().hasOnly([
          "userId",
          "mutedUserId",
          "mutedAt",
          "mutedUntil",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.mutedUserId == mutedUserId
        && request.resource.data.mutedUserId != userId
        && request.resource.data.mutedAt is timestamp
        && (
          request.resource.data.mutedUntil is timestamp
          || request.resource.data.mutedUntil == null
        )
        && request.resource.data.updatedAt is timestamp;
      }

      allow get, list: if isOwner();
      allow create, update: if isOwner() && hasValidMutedChatUserData();
      allow delete: if isOwner();
    }

    match /users/{userId}/hiddenPostAuthors/{authorId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidHiddenPostAuthorData() {
        return request.resource.data.keys().hasOnly([
          "userId",
          "authorId",
          "displayName",
          "nickname",
          "avatarUrl",
          "sourcePostId",
          "hiddenAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.authorId == authorId
        && request.resource.data.authorId != userId
        && request.resource.data.displayName is string
        && request.resource.data.nickname is string
        && request.resource.data.avatarUrl is string
        && request.resource.data.sourcePostId is string
        && request.resource.data.hiddenAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasValidHiddenPostAuthorData();
      allow delete: if isOwner();
    }

    match /users/{userId}/feedImpressions/{postId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidImpressionData() {
        return request.resource.data.keys().hasOnly([
          "userId", "postId", "source", "impressionCount",
          "totalDwellMs", "lastDwellMs", "firstSeenAt", "lastSeenAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.postId == postId
        && request.resource.data.source is string
        && request.resource.data.impressionCount is int
        && request.resource.data.impressionCount > 0
        && request.resource.data.totalDwellMs is int
        && request.resource.data.totalDwellMs >= 0
        && request.resource.data.lastDwellMs is int
        && request.resource.data.lastDwellMs >= 0
        && request.resource.data.lastDwellMs <= 120000;
      }

      allow read: if isOwner();
      allow create: if isOwner() && hasValidImpressionData()
        && request.resource.data.impressionCount == 1;
      allow update: if isOwner() && hasValidImpressionData()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt
        && request.resource.data.impressionCount == resource.data.impressionCount + 1
        && request.resource.data.totalDwellMs >= resource.data.totalDwellMs;
      allow delete: if false;
    }

    match /users/{userId}/hiddenPosts/{postId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidHiddenPostData() {
        return request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "authorId",
          "hiddenAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.postId == postId
        && request.resource.data.authorId is string
        && request.resource.data.hiddenAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow get, list: if isOwner();
      allow create, update: if isOwner() && hasValidHiddenPostData();
      allow delete: if isOwner();
    }

    match /users/{userId}/blockedUsers/{blockedUserId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidBlockedUserData() {
        return request.resource.data.keys().hasOnly([
          "userId",
          "blockedUserId",
          "displayName",
          "nickname",
          "avatarUrl",
          "blockedAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.blockedUserId == blockedUserId
        && request.resource.data.blockedUserId != userId
        && request.resource.data.displayName is string
        && request.resource.data.nickname is string
        && request.resource.data.avatarUrl is string
        && request.resource.data.blockedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow get, list: if isOwner();
      allow create, update: if isOwner() && hasValidBlockedUserData();
      allow delete: if isOwner();
    }

    match /users/{userId}/blockedBy/{blockerId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isBlocker() {
        return request.auth != null && request.auth.uid == blockerId;
      }

      function hasValidBlockedByData() {
        return request.resource.data.keys().hasOnly([
          "userId",
          "blockerId",
          "blockedAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.blockerId == blockerId
        && request.resource.data.blockerId != userId
        && request.resource.data.blockedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow get, list: if isOwner();
      allow create, update: if isBlocker() && hasValidBlockedByData();
      allow delete: if isBlocker();
    }

    match /users/{userId}/security/backup {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasMatchingActiveGeneration() {
        let statePath =
          /databases/$(database)/documents/users/$(userId)/security/passcodeState;
        return !exists(statePath)
          || (
            get(statePath).data.status == "active"
            && request.resource.data.generation
              == get(statePath).data.generation
          );
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && hasMatchingActiveGeneration();
      allow delete: if false;
    }

    match /users/{userId}/security/faceBackup {
      allow read, write: if false;
    }

    match /users/{userId}/security/passcodeState {
      allow read, write: if false;
    }

    match /users/{userId}/sessionKeyBackups/{roomId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasMatchingActiveGeneration() {
        let statePath =
          /databases/$(database)/documents/users/$(userId)/security/passcodeState;
        return !exists(statePath)
          || (
            get(statePath).data.status == "active"
            && request.resource.data.generation
              == get(statePath).data.generation
          );
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && hasMatchingActiveGeneration();
    }

    match /users/{userId}/sessionKeyBackups/{roomId}/keys/{keyId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasMatchingActiveGeneration() {
        let statePath =
          /databases/$(database)/documents/users/$(userId)/security/passcodeState;
        return !exists(statePath)
          || (
            get(statePath).data.status == "active"
            && request.resource.data.generation
              == get(statePath).data.generation
          );
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && hasMatchingActiveGeneration();
    }

    // Biometric templates and short-lived re-auth sessions are server-only.
    match /faceEnrollments/{userId} {
      allow read, write: if false;
    }

    match /faceReauthSessions/{sessionId} {
      allow read, write: if false;
    }

    match /faceLivenessChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /faceLivenessRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /faceTemplateUpdateAuthorizations/{authorizationId} {
      allow read, write: if false;
    }

    // Wallet mutations and their audit trail are Cloud Functions-only.
    match /gemTransactions/{transactionId} {
      allow read, write: if false;
    }

    // Recommendation retrieval/index documents are maintained by Admin SDK
    // Cloud Functions and are never exposed directly to clients.
    match /postRecommendationIndex/{postId} {
      allow read, write: if false;
    }

    match /system/{documentId} {
      allow read, write: if false;
    }

    // ================= POSTS / SOCIAL FEED =================
    match /posts/{postId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isAuthor() {
        return isSignedIn() && request.auth.uid == resource.data.authorId;
      }

      function isAuthorCreate() {
        return isSignedIn() && request.resource.data.authorId == request.auth.uid;
      }

      function touchesServerManagedPostRecommendationFields() {
        return request.resource.data.diff(resource.data).changedKeys().hasAny([
          "contentVector",
          "contentEmbeddingModel",
          "contentEmbeddingSignature",
          "contentVectorDimensions",
          "contentVectorSearchKey",
          "contentVectorUpdatedAt",
          "recommendationStatus",
          "recommendationErrorCode",
          "recommendationAttemptCount",
          "recommendationUpdatedAt",
          "trendScore",
          "trendBucket"
        ]);
      }

      function hasValidPostRecommendationCreateDefaults() {
        return (
          !("contentVector" in request.resource.data)
          || (
            request.resource.data.contentVector is list
            && request.resource.data.contentVector.size() == 0
          )
        )
        && !("contentEmbeddingModel" in request.resource.data)
        && !("contentEmbeddingSignature" in request.resource.data)
        && !("contentVectorDimensions" in request.resource.data)
        && !("contentVectorSearchKey" in request.resource.data)
        && !("contentVectorUpdatedAt" in request.resource.data)
        && !("recommendationStatus" in request.resource.data)
        && !("recommendationErrorCode" in request.resource.data)
        && !("recommendationAttemptCount" in request.resource.data)
        && !("recommendationUpdatedAt" in request.resource.data)
        && (
          !("trendScore" in request.resource.data)
          || request.resource.data.trendScore == 0
        )
        && (
          !("trendBucket" in request.resource.data)
          || request.resource.data.trendBucket == 0
        );
      }

      function hasValidPostStatsCreateDefaults() {
        return request.resource.data.stats is map
          && request.resource.data.stats.likeCount == 0
          && request.resource.data.stats.commentCount == 0
          && request.resource.data.stats.shareCount == 0
          && request.resource.data.stats.saveCount == 0
          && (
            !("externalShareCount" in request.resource.data.stats)
            || request.resource.data.stats.externalShareCount == 0
          );
      }

      function authorReputationScore() {
        let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return userData.reputationScore is number
          ? userData.reputationScore
          : (
            userData.reputation is number
              ? userData.reputation
              : 100
          );
      }

      function canCreatePostByReputation() {
        return isSignedIn() && authorReputationScore() >= 60;
      }

      function isOwnRepostDocPath() {
        return isSignedIn()
          && postId.matches('^repost_' + request.auth.uid + '_.*$');
      }

      function canProbeOwnRepostDoc() {
        return isOwnRepostDocPath()
          && !exists(/databases/$(database)/documents/posts/$(postId));
      }

      function canReadPost() {
        return canAccessPostData(resource.data)
          || isAuthor()
          || canProbeOwnRepostDoc();
      }

      function oldStatsValue(key) {
        return resource.data.stats is map
          && resource.data.stats[key] is number
          ? resource.data.stats[key]
          : 0;
      }

      function newStatsValue(key) {
        return request.resource.data.stats is map
          && request.resource.data.stats[key] is number
          ? request.resource.data.stats[key]
          : 0;
      }

      function isCounterDelta(key) {
        return newStatsValue(key) >= 0
          && (
            newStatsValue(key) == oldStatsValue(key) + 1
            || newStatsValue(key) == oldStatsValue(key) - 1
          );
      }

      function isStatsCounterOnlyUpdate() {
        return isSignedIn()
          && canAccessPostData(resource.data)
          && request.resource.data.stats is map
          && resource.data.stats is map
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["stats", "updatedAt"])
          && (
            request.resource.data.stats.diff(resource.data.stats)
              .changedKeys()
              .hasOnly(["likeCount"])
            && isCounterDelta("likeCount")
            || (
              request.resource.data.stats.diff(resource.data.stats)
                .changedKeys()
                .hasOnly(["commentCount"])
              && isCounterDelta("commentCount")
            )
            || (
              request.resource.data.stats.diff(resource.data.stats)
                .changedKeys()
                .hasOnly(["shareCount"])
              && isCounterDelta("shareCount")
            )
            || (
              request.resource.data.stats.diff(resource.data.stats)
                .changedKeys()
                .hasOnly(["saveCount"])
              && isCounterDelta("saveCount")
              && (
                (
                  newStatsValue("saveCount") == oldStatsValue("saveCount") + 1
                  && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/savedPosts/$(postId))
                )
                || (
                  newStatsValue("saveCount") == oldStatsValue("saveCount") - 1
                  && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/savedPosts/$(postId))
                )
              )
            )
          );
      }

      function changedPostKeys() {
        return request.resource.data.diff(resource.data).changedKeys();
      }

      function touchesRestrictedPostModerationFields() {
        return changedPostKeys().hasAny([
          "moderationStatus",
          "moderationMessageVi",
          "videoModeration",
          "videoModerationProcessedAt"
        ]);
      }

      function isAllowedAuthorPostModerationUpdate() {
        let status = postModerationStatus(request.resource.data);
        return !touchesRestrictedPostModerationFields()
          || (
            status == "pending_moderation"
            && postVisibility(request.resource.data) == "private"
            && request.resource.data.isPublic == false
            && request.resource.data.requestedVisibility is string
            && isValidPostVisibilityValue(request.resource.data.requestedVisibility)
            && !changedPostKeys().hasAny([
              "moderationMessageVi",
              "videoModeration",
              "videoModerationProcessedAt"
            ])
          );
      }

      allow read: if canReadPost();
      allow create: if isAuthorCreate()
        && canUseAccountFeature("posts")
        && canCreatePostByReputation()
        && hasValidPostVisibilityForWrite(request.resource.data)
        && hasValidPostModerationForCreate(request.resource.data)
        && hasValidPostStatsCreateDefaults()
        && hasValidPostRecommendationCreateDefaults();
      allow update: if (
          isAuthor()
          && hasValidPostVisibilityForWrite(request.resource.data)
          && hasValidPostModerationForWrite(request.resource.data)
          && isAllowedAuthorPostModerationUpdate()
          && newStatsValue("externalShareCount") ==
            oldStatsValue("externalShareCount")
          && !touchesServerManagedPostRecommendationFields()
        ) || isStatsCounterOnlyUpdate();
      allow delete: if isAuthor();

      match /likes/{userId} {

        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }

        function canAccessParentPost() {
          return canAccessPostData(parentPost());
        }

        allow read: if request.auth != null
          && request.auth.uid == userId
          && canAccessParentPost();

        allow create: if request.auth != null
          && request.auth.uid == userId
          && canAccessParentPost()
          && request.resource.data.userId == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == userId
          && canAccessParentPost();

        allow update: if false;
      }

      match /comments/{commentId} {

        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }

        function canAccessParentPost() {
          return canAccessPostData(parentPost());
        }

        allow read: if canAccessParentPost();

        allow create: if request.auth != null
          && canUseAccountFeature("comments")
          && canAccessParentPost()
          && request.resource.data.userId == request.auth.uid;

        function oldReplyCount() {
          return resource.data.replyCount is number
            ? resource.data.replyCount
            : 0;
        }

        function newReplyCount() {
          return request.resource.data.replyCount is number
            ? request.resource.data.replyCount
            : 0;
        }

        function oldLikeCount() {
          return resource.data.likeCount is number
            ? resource.data.likeCount
            : 0;
        }

        function newLikeCount() {
          return request.resource.data.likeCount is number
            ? request.resource.data.likeCount
            : 0;
        }

        function affectedCommentKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        function isCommentOwner() {
          return request.auth != null
            && request.auth.uid == resource.data.userId;
        }

        function isParentPostAuthor() {
          return request.auth != null
            && request.auth.uid == parentPost().authorId;
        }

        function isDeletedComment() {
          return resource.data.keys().hasAny(["deletedAt"])
            && resource.data.deletedAt != null;
        }

        function isCommentCounterUpdate() {
          return (
            affectedCommentKeys().hasOnly(["replyCount"])
            && newReplyCount() >= 0
            && (
              newReplyCount() == oldReplyCount() + 1
              || newReplyCount() == oldReplyCount() - 1
            )
          ) || (
            affectedCommentKeys().hasOnly(["likeCount"])
            && newLikeCount() >= 0
            && (
              newLikeCount() == oldLikeCount() + 1
              || newLikeCount() == oldLikeCount() - 1
            )
          );
        }

        function isCommentContentEdit() {
          return isCommentOwner()
            && !isDeletedComment()
            && affectedCommentKeys().hasOnly(["content", "isEdited", "updatedAt"])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 300
            && request.resource.data.isEdited == true;
        }

        function isCommentSoftDelete() {
          return (isCommentOwner() || isParentPostAuthor())
            && !isDeletedComment()
            && affectedCommentKeys().hasOnly([
              "content",
              "imageUrl",
              "voiceUrl",
              "voiceDurationMs",
              "deletedAt",
              "deletedBy",
              "updatedAt",
            ])
            && request.resource.data.content == ""
            && request.resource.data.imageUrl == ""
            && request.resource.data.voiceUrl == ""
            && request.resource.data.voiceDurationMs == null
            && request.resource.data.deletedBy == request.auth.uid
            && request.resource.data.deletedAt is timestamp
            && existsAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/moderationEvidence/original
            );
        }

        allow update: if request.auth != null
          && canAccessParentPost()
          && (
            isCommentCounterUpdate()
            || isCommentContentEdit()
            || isCommentSoftDelete()
          );

        allow delete: if false;

        match /likes/{userId} {

          allow read: if request.auth != null
            && request.auth.uid == userId
            && canAccessParentPost();

          allow create: if request.auth != null
            && request.auth.uid == userId
            && canAccessParentPost()
            && request.resource.data.userId == request.auth.uid;

          allow delete: if request.auth != null
            && request.auth.uid == userId
            && canAccessParentPost();

          allow update: if false;
        }

        // Original payload retained for moderation after a public soft delete.
        // Mobile clients can create the immutable snapshot atomically, but can
        // never read it back. Admin SDK access bypasses these client rules.
        match /moderationEvidence/{evidenceId} {
          function sourceComment() {
            return get(
              /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)
            ).data;
          }

          function isAllowedDeleter() {
            return request.auth != null
              && (
                request.auth.uid == sourceComment().userId
                || request.auth.uid == get(
                  /databases/$(database)/documents/posts/$(postId)
                ).data.authorId
              );
          }

          function sourceParentId() {
            return sourceComment().keys().hasAny(["parentId"])
              ? sourceComment().parentId
              : null;
          }

          function sourceContent() {
            return sourceComment().keys().hasAny(["content"])
              ? sourceComment().content
              : "";
          }

          function sourceImageUrl() {
            return sourceComment().keys().hasAny(["imageUrl"])
              ? sourceComment().imageUrl
              : "";
          }

          function sourceVoiceUrl() {
            return sourceComment().keys().hasAny(["voiceUrl"])
              ? sourceComment().voiceUrl
              : "";
          }

          function sourceVoiceDurationMs() {
            return sourceComment().keys().hasAny(["voiceDurationMs"])
              ? sourceComment().voiceDurationMs
              : null;
          }

          function sourceCreatedAt() {
            return sourceComment().keys().hasAny(["createdAt"])
              ? sourceComment().createdAt
              : null;
          }

          function isValidOriginalEvidence() {
            return evidenceId == "original"
              && request.resource.data.keys().hasOnly([
                "postId",
                "commentId",
                "userId",
                "parentId",
                "content",
                "imageUrl",
                "voiceUrl",
                "voiceDurationMs",
                "createdAt",
                "capturedAt",
                "deletedBy",
              ])
              && request.resource.data.postId == postId
              && request.resource.data.commentId == commentId
              && request.resource.data.userId == sourceComment().userId
              && request.resource.data.parentId == sourceParentId()
              && request.resource.data.content == sourceContent()
              && request.resource.data.imageUrl == sourceImageUrl()
              && request.resource.data.voiceUrl == sourceVoiceUrl()
              && request.resource.data.voiceDurationMs == sourceVoiceDurationMs()
              && request.resource.data.createdAt == sourceCreatedAt()
              && request.resource.data.deletedBy == request.auth.uid
              && request.resource.data.capturedAt is timestamp;
          }

          allow create: if isAllowedDeleter() && isValidOriginalEvidence();
          allow read, update, delete: if false;
        }
      }
    }

    // Matching is server-authoritative. A client may only observe its own
    // session document; callable functions own every write.
    match /tempChatMatchingQueue/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ================= TEMP CHAT ROOM =================
    match /tempChats/{roomId} {

      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      function hasValidSuggestionPreference(game) {
        return (
            !game.keys().hasAny(["suggestionsDisabled"])
            || game.suggestionsDisabled is bool
          )
          && (
            !game.keys().hasAny(["suggestionsDisabledBy"])
            || game.suggestionsDisabledBy is string
          )
          && (
            !game.keys().hasAny(["suggestionsDisabledAt"])
            || game.suggestionsDisabledAt is timestamp
          );
      }

      function isValidMinigame() {
        return request.resource.data.minigame is map
          && request.resource.data.minigame.type == "telepathy"
          && request.resource.data.minigame.keys().hasOnly([
            "type",
            "status",
            "invitedAt",
            "consent",
            "cancelledBy",
            "cancelledAt",
            "finishedAt",
            "hookSent",
            "result",
            "aiInsight",
            "questions",
            "answers",
            "currentQuestionIndex",
            "questionStartedAt",
            "startedAt",
            "countdownStartedAt",
            "suggestionsDisabled",
            "suggestionsDisabledBy",
            "suggestionsDisabledAt"
          ])
          && hasValidSuggestionPreference(request.resource.data.minigame);
      }

      function isValidWordChainReward() {
        return !request.resource.data.minigames.wordChain.keys()
            .hasAny(["reward"])
          || (
            request.resource.data.minigames.wordChain.reward is map
            && request.resource.data.minigames.wordChain.reward.keys().hasOnly([
              "phase",
              "question",
              "questionPresetId",
              "answer",
              "declineCount",
              "askingStartedAt",
              "answeringStartedAt",
              "askedAt",
              "answeredAt",
              "reviewStartedAt",
              "autoAcceptedReason",
              "completedAt"
            ])
            && request.resource.data.minigames.wordChain.reward.phase is string
            && request.resource.data.minigames.wordChain.reward.declineCount is number
            && (
              request.resource.data.minigames.wordChain.reward.question is string
              || request.resource.data.minigames.wordChain.reward.question == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.questionPresetId is string
              || request.resource.data.minigames.wordChain.reward.questionPresetId == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.answer is string
              || request.resource.data.minigames.wordChain.reward.answer == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.askingStartedAt is timestamp
              || request.resource.data.minigames.wordChain.reward.askingStartedAt == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.answeringStartedAt is timestamp
              || request.resource.data.minigames.wordChain.reward.answeringStartedAt == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.askedAt is timestamp
              || request.resource.data.minigames.wordChain.reward.askedAt == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.answeredAt is timestamp
              || request.resource.data.minigames.wordChain.reward.answeredAt == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.reviewStartedAt is timestamp
              || request.resource.data.minigames.wordChain.reward.reviewStartedAt == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.autoAcceptedReason is string
              || request.resource.data.minigames.wordChain.reward.autoAcceptedReason == null
            )
            && (
              request.resource.data.minigames.wordChain.reward.completedAt is timestamp
              || request.resource.data.minigames.wordChain.reward.completedAt == null
            )
          );
      }

      function isValidWordChainPendingWord() {
        return !request.resource.data.minigames.wordChain.keys()
            .hasAny(["pendingWord"])
          || (
            request.resource.data.minigames.wordChain.pendingWord is map
            && request.resource.data.minigames.wordChain.pendingWord.keys()
              .hasOnly([
                "word",
                "uid",
                "createdAt"
              ])
            && request.resource.data.minigames.wordChain.pendingWord.word is string
            && request.resource.data.minigames.wordChain.pendingWord.uid is string
            && (
              request.resource.data.minigames.wordChain.pendingWord.createdAt is timestamp
              || request.resource.data.minigames.wordChain.pendingWord.createdAt == null
            )
          );
      }

      function isValidWordChainInvalidReason() {
        return !request.resource.data.minigames.wordChain.keys()
            .hasAny(["invalidReason"])
          || request.resource.data.minigames.wordChain.invalidReason is string;
      }

      function isValidWordChainMinigame() {
        return request.resource.data.minigames is map
          && request.resource.data.minigames.keys().hasOnly(["wordChain"])
          && request.resource.data.minigames.wordChain is map
          && request.resource.data.minigames.wordChain.keys().hasOnly([
            "status",
            "invitedAt",
            "countdownStartedAt",
            "consent",
            "cancelledBy",
            "cancelledAt",
            "startedAt",
            "currentWord",
            "turnUid",
            "remainingSeconds",
            "usedWords",
            "hearts",
            "sosUsed",
            "winnerUid",
            "reward",
            "updatedAt",
            "pendingWord",
            "invalidReason",
            "suggestionsDisabled",
            "suggestionsDisabledBy",
            "suggestionsDisabledAt"
          ])
          && request.resource.data.minigames.wordChain.status is string
          && request.resource.data.minigames.wordChain.currentWord is string
          && request.resource.data.minigames.wordChain.turnUid is string
          && request.resource.data.minigames.wordChain.remainingSeconds is number
          && request.resource.data.minigames.wordChain.usedWords is list
          && request.resource.data.minigames.wordChain.hearts is map
          && request.resource.data.minigames.wordChain.sosUsed is map
          && request.resource.data.minigames.wordChain.consent is map
          && (
            !request.resource.data.minigames.wordChain.keys().hasAny(["winnerUid"])
            || request.resource.data.minigames.wordChain.winnerUid is string
          )
          && isValidWordChainReward()
          && isValidWordChainPendingWord()
          && isValidWordChainInvalidReason()
          && hasValidSuggestionPreference(
            request.resource.data.minigames.wordChain
          );
      }

      function onlyUpdateMyAvatar() {
        // Các field thay đổi
        let changed = request.resource.data.diff(resource.data).changedKeys();

        // Chỉ được thay đổi đúng 1 field
        return changed.size() == 1
          && changed.hasOnly(["anonymousAvatars"])
          && request.resource.data.anonymousAvatars.keys().hasOnly(
            resource.data.anonymousAvatars.keys().union([request.auth.uid])
          )
          && request.resource.data.anonymousAvatars[request.auth.uid]
              == request.resource.data.anonymousAvatars[request.auth.uid];
      }

      function onlyUpdatesOwnLike() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return !(changed.hasAny(["userALiked"]) && request.auth.uid != resource.data.userA)
          && !(changed.hasAny(["userBLiked"]) && request.auth.uid != resource.data.userB);
      }

      function onlyUpdatesOwnVideoCameraState() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return !changed.hasAny(["videoCameraStates"])
          || (
            resource.data.matchingMode == "video"
            && resource.data.cameraUnlockAt is timestamp
            && request.time >= resource.data.cameraUnlockAt
            && request.resource.data.videoCameraStates is map
            && request.resource.data.videoCameraStates.keys()
              .hasAll(resource.data.participants)
            && request.resource.data.videoCameraStates.keys()
              .hasOnly(resource.data.participants)
            && request.resource.data.videoCameraStates[request.auth.uid] is bool
            && (
              request.auth.uid == resource.data.userA
              && request.resource.data.videoCameraStates[resource.data.userB]
                == resource.data.videoCameraStates[resource.data.userB]
              || request.auth.uid == resource.data.userB
              && request.resource.data.videoCameraStates[resource.data.userA]
                == resource.data.videoCameraStates[resource.data.userA]
            )
          );
      }

      function onlyUpdatesOwnVideoMutedState() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return !changed.hasAny(["videoMutedStates"])
          || (
            resource.data.matchingMode == "video"
            && request.resource.data.videoMutedStates is map
            && request.resource.data.videoMutedStates.keys()
              .hasAll(resource.data.participants)
            && request.resource.data.videoMutedStates.keys()
              .hasOnly(resource.data.participants)
            && request.resource.data.videoMutedStates[request.auth.uid] is bool
            && (
              request.auth.uid == resource.data.userA
              && request.resource.data.videoMutedStates[resource.data.userB]
                == resource.data.videoMutedStates[resource.data.userB]
              || request.auth.uid == resource.data.userB
              && request.resource.data.videoMutedStates[resource.data.userA]
                == resource.data.videoMutedStates[resource.data.userA]
            )
          );
      }

      function onlyUpdatesOwnTyping() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return !changed.hasAny(["typing"])
          || !resource.data.keys().hasAny(["typing"])
          || (
            request.auth.uid == resource.data.userA
            && request.resource.data.typing.userB == resource.data.typing.userB
          )
          || (
            request.auth.uid == resource.data.userB
            && request.resource.data.typing.userA == resource.data.typing.userA
          );
      }

      function isValidClientEndTransition() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        let lifecycleFields = [
          "status",
          "endedBy",
          "endedReason",
          "endedAt",
          "permanentRoomId"
        ];
        return !changed.hasAny(lifecycleFields)
          || (
            resource.data.status == "active"
            && request.resource.data.status == "ended"
            && request.resource.data.endedBy == request.auth.uid
            && request.resource.data.endedReason in ["left", "timeout"]
            && request.resource.data.permanentRoomId == resource.data.permanentRoomId
          );
      }

      // 👀 READ temp chat room
      allow read: if isParticipant();


      // ➕ Create room
      allow create: if false;

      // ✏️ Update
      allow update: if isParticipant()
        && onlyUpdatesOwnLike()
        && onlyUpdatesOwnVideoCameraState()
        && onlyUpdatesOwnVideoMutedState()
        && onlyUpdatesOwnTyping()
        && isValidClientEndTransition()
        && (
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              "userALiked",
              "userBLiked",
              "videoCameraStates",
              "videoMutedStates",
              "typing",
              "status",
              "endedBy",
              "endedReason",
              "permanentRoomId",
              "endedAt",
              "minigame",
              "minigames"
            ])
          && (
            !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(["minigame"])
            || isValidMinigame()
          )
          && (
            !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(["minigames"])
            || isValidWordChainMinigame()
          )
          || (
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["anonymousAvatars"])
            && request.resource.data.anonymousAvatars[request.auth.uid] is string
            && (
              request.auth.uid == resource.data.userA
              && request.resource.data.anonymousAvatars[resource.data.userB]
                == resource.data.anonymousAvatars[resource.data.userB]
              || request.auth.uid == resource.data.userB
              && request.resource.data.anonymousAvatars[resource.data.userA]
                == resource.data.anonymousAvatars[resource.data.userA]
            )
          )
        );

      allow delete: if false;

      // Ephemeral typing state lives outside the hot room document so typing
      // does not wake room and minigame listeners.
      match /presence/{presenceUid} {
        function isRoomParticipant() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/tempChats/$(roomId))
                .data.participants;
        }

        function isValidOwnPresence() {
          return request.auth.uid == presenceUid
            && request.resource.data.keys().hasOnly([
              "uid",
              "isTyping",
              "updatedAt",
              "expiresAt"
            ])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.isTyping is bool
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.expiresAt is timestamp;
        }

        allow read: if isRoomParticipant();
        allow create, update: if isRoomParticipant()
          && get(/databases/$(database)/documents/tempChats/$(roomId))
              .data.status == "active"
          && isValidOwnPresence();
        allow delete: if isRoomParticipant()
          && request.auth.uid == presenceUid;
      }

      // ================= MESSAGES Temp =================
      match /messages/{messageId} {

        function isRoomParticipant() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/tempChats/$(roomId))
                .data.participants;
        }

        function isPendingUserMessageCreate() {
          return (
            !request.resource.data.keys().hasAny(["type"])
            || request.resource.data.type != "system"
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (
            !request.resource.data.keys().hasAny(["clientMessageId"])
            || request.resource.data.clientMessageId == messageId
          )
          && request.resource.data.status == "pending"
          && request.resource.data.blockedBy == null
          && request.resource.data.reason == null
          && request.resource.data.warning == false
          && request.resource.data.aiScore == null;
        }

        function isLegacySystemMessageCreate() {
          return request.resource.data.type == "system"
            && request.resource.data.text is string;
        }

        allow read: if isRoomParticipant();

        allow create: if isRoomParticipant()
          && get(/databases/$(database)/documents/tempChats/$(roomId))
              .data.status == "active"
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt != null
          && (
            (
              isPendingUserMessageCreate()
              && canUseAccountFeature("chat")
              && participantsHaveNoBlock(
                get(/databases/$(database)/documents/tempChats/$(roomId)).data
              )
            )
            || isLegacySystemMessageCreate()
          );

        allow update: if isRoomParticipant()
          && request.writeFields.size() == 1
          && request.writeFields.hasOnly([
            "reactions." + request.auth.uid
          ]);

        allow delete: if false;
      }
    }

    // ================= CHAT ROOMS =================
    match /chatRooms/{roomId} {

      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      // 👀 đọc room
      allow read: if isParticipant();

      // ➕ tạo room (khi convert)
      allow create: if request.auth != null
        && canUseAccountFeature("chat")
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && participantsHaveNoBlock(request.resource.data);

      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "lastMessage",
            "lastMessageType",
            "lastMessageCipher",
            "lastMessageIv",
            "lastMessageKeyId",
            "lastSenderId",
            "lastMessageAt",
            "unread",
            "pinned",
            "deletedFor",
            "clearedAt",
            "typing",
            "currentKeyId",
            "currentKeyUpdatedAt",
            "sessionKeyLocks"
          ]);
      
       // ===============================
      // 🔐 SESSION KEYS (E2EE) - KHÔNG ROTATE KEY
      // ===============================
      match /sessionKeys/{deviceId} {

        function isRoomParticipant() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/chatRooms/$(roomId))
                .data.participants;
        }

        // ✅ BỎ epoch - chỉ cần userId, encryptedKey, createdAt
        allow create, update: if isRoomParticipant()
          && (
            request.resource.data.keys().hasOnly([
              "userId",
              "encryptedKey",
              "createdAt"
            ])
            || request.resource.data.keys().hasOnly([
              "userId",
              "encryptedKey",
              "createdAt",
              "keyId"
            ])
          )
          && request.resource.data.userId is string
          && request.resource.data.userId in
              get(/databases/$(database)/documents/chatRooms/$(roomId))
                .data.participants
          && request.resource.data.encryptedKey is string
          && (
            !("keyId" in request.resource.data)
            || request.resource.data.keyId is int
          );

        // cho phép participant đọc
        allow read: if isRoomParticipant();

        allow delete: if false;
      }

      match /keyRequests/{requestId} {
        function isRoomParticipant() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/chatRooms/$(roomId))
                .data.participants;
        }

        function ownsRequestedDevice(data) {
          return data.userId == request.auth.uid
            && data.deviceId is string
            && exists(
              /databases/$(database)/documents/users/$(request.auth.uid)/devices/$(data.deviceId)
            );
        }

        allow read: if isRoomParticipant();
        allow create: if isRoomParticipant()
          && request.resource.data.keys().hasOnly([
            "userId",
            "deviceId",
            "keyId",
            "status",
            "requestedAt"
          ])
          && ownsRequestedDevice(request.resource.data)
          && request.resource.data.keyId is int
          && request.resource.data.status == "pending";
        allow update: if isRoomParticipant()
          && (
            (
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["status", "fulfilledAt"])
              && request.resource.data.status == "fulfilled"
            )
            || (
              ownsRequestedDevice(request.resource.data)
              && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["status", "requestedAt", "fulfilledAt"])
              && request.resource.data.status == "pending"
            )
          );
        allow delete: if isRoomParticipant()
          && resource.data.userId == request.auth.uid;
      }

      // ================= MESSAGES Long =================
      match /messages/{messageId} {

        function isRoomParticipant() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/chatRooms/$(roomId))
                .data.participants;
        }

        // 👀 đọc tin nhắn
        allow read: if isRoomParticipant();

        // ➕ gửi / copy tin nhắn
        allow create: if isRoomParticipant()
          && canUseAccountFeature("chat")
          && participantsHaveNoBlock(
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data
          )
          && request.resource.data.senderId is string
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt != null;

        function viewedByMap() {
          return resource.data.viewedBy is map
            ? resource.data.viewedBy
            : {};
        }

        function isViewOnceRecipient() {
          return request.auth.uid != resource.data.senderId;
        }

        function isViewOnceImage() {
          return resource.data.viewOnce == true
            && resource.data.type == "image";
        }

        function isSender() {
          return request.auth.uid == resource.data.senderId;
        }

        allow update: if isRoomParticipant()
          && (
            request.writeFields.size() == 1
            && request.writeFields.hasOnly([
              "reactions." + request.auth.uid
            ])

            || (
              isSender()
              && request.resource.data.senderId == resource.data.senderId
              && request.resource.data.createdAt == resource.data.createdAt
              && (request.resource.data.type == "text"
                  || request.resource.data.type == "deleted")
              && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  "ciphertext",
                  "iv",
                  "keyId",
                  "type",
                  "editedAt",
                  "editedBy",
                  "deletedAt",
                  "deletedBy"
                ])
            )

            || (
              isViewOnceImage()
              && isViewOnceRecipient()
              && request.resource.data.senderId == resource.data.senderId
              && request.resource.data.viewOnce == true
              && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  "viewedBy",
                  "type",
                  "text",
                  "imagePath",
                  "imageDeleted",
                  "deletedAt",
                  "deletedBy"
                ])
              && request.resource.data.viewedBy is map
              && request.resource.data.viewedBy.keys().hasOnly(
                viewedByMap().keys().union([request.auth.uid])
              )
            )
          );

      }
    }

  
    // ================= CALL SESSIONS (WEBRTC SIGNALING) =================
    match /callSessions/{callId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isCallParticipant() {
        return isSignedIn()
          && request.auth.uid in resource.data.participants;
      }

      function isValidCallType(value) {
        return value == "audio" || value == "video";
      }

      function isValidCallStatus(value) {
        return value in ["ringing", "active", "rejected", "ended", "busy", "missed"];
      }

      function roomExistsAndBothAreParticipants() {
        let roomId = request.resource.data.roomChatId;
        return roomId is string
          && exists(/databases/$(database)/documents/chatRooms/$(roomId))
          && request.resource.data.callerId in
            get(/databases/$(database)/documents/chatRooms/$(roomId))
              .data.participants
          && request.resource.data.receiverId in
            get(/databases/$(database)/documents/chatRooms/$(roomId))
              .data.participants;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).changedKeys();
      }

      // Read is allowed for caller/receiver.
      // This makes incoming-call query by receiverId/status pass rule checks.
      allow read: if isSignedIn()
        && (
          request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.receiverId
          || isCallParticipant()
        );

      // Caller creates the session with initial SDP offer.
      allow create: if isSignedIn()
        && canUseAccountFeature("calls")
        && request.resource.data.keys().hasOnly([
          "callId",
          "roomChatId",
          "callerId",
          "receiverId",
          "participants",
          "type",
          "status",
          "offer",
          "answer",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.callId == callId
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && !isBlockedBetween(
          request.resource.data.callerId,
          request.resource.data.receiverId
        )
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.resource.data.callerId,
          request.resource.data.receiverId
        ])
        && request.resource.data.type is string
        && isValidCallType(request.resource.data.type)
        && request.resource.data.status == "ringing"
        && request.resource.data.offer is map
        && request.resource.data.answer == null
        && roomExistsAndBothAreParticipants();

      // Participants can only update signaling fields.
      allow update: if isCallParticipant()
        && (
          !changedKeys().hasAny(["answer"])
          || canUseAccountFeature("calls")
        )
        && changedKeys().hasOnly([
          "offer",
          "answer",
          "status",
          "updatedAt",
          "answeredAt",
          "endedAt"
        ])
        && request.resource.data.callId == resource.data.callId
        && request.resource.data.roomChatId == resource.data.roomChatId
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.type == resource.data.type
        && request.resource.data.status is string
        && isValidCallStatus(request.resource.data.status)
        && (
          !changedKeys().hasAny(["offer"])
          || (
            request.auth.uid == resource.data.callerId
            && request.resource.data.offer is map
          )
        )
        && (
          !changedKeys().hasAny(["answer"])
          || (
            request.auth.uid == resource.data.receiverId
            && request.resource.data.answer is map
          )
        );

      allow delete: if false;

      function canReadCandidate() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/callSessions/$(callId))
          && request.auth.uid in
            get(/databases/$(database)/documents/callSessions/$(callId))
              .data.participants;
      }

      function canCreateCandidate() {
        return canReadCandidate()
          && request.resource.data.senderId == request.auth.uid;
      }

      function isValidCandidateDoc() {
        return request.resource.data.keys().hasOnly([
          "candidate",
          "sdpMid",
          "sdpMLineIndex",
          "senderId",
          "createdAt"
        ])
        && request.resource.data.candidate is string
        && (
          request.resource.data.sdpMid == null
          || request.resource.data.sdpMid is string
        )
        && (
          request.resource.data.sdpMLineIndex == null
          || request.resource.data.sdpMLineIndex is int
          || request.resource.data.sdpMLineIndex is number
        );
      }

      match /callerCandidates/{candidateId} {
        allow read: if canReadCandidate();
        allow create: if canCreateCandidate() && isValidCandidateDoc();
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if canReadCandidate();
        allow create: if canCreateCandidate() && isValidCandidateDoc();
        allow update, delete: if false;
      }
    }

  
    match /chatRatings/{id} {

      // 👀 Transaction cần read
      allow read: if request.auth != null;

      // ➕ Create rating (mỗi user chỉ rate từ UID của mình)
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // ❌ Không update / delete
      allow update, delete: if false;
    }
		
    // ================= USER MATCHING REPORT =================
    match /userMatchingReports/{reportId} {

      // ➕ Create report
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // ❌ Không cho đọc / sửa / xóa
      allow read, update, delete: if false;
    }

    // ================= POST REPORT =================
    match /postReports/{reportId} {

      // Create report
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // Không cho đọc / sửa / xóa
      allow read, update, delete: if false;
    }

    // ================= USER PROFILE REPORT =================
    match /userProfileReports/{reportId} {

      // ➕ Create report
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // ❌ Không cho đọc / sửa / xóa
      allow read, update, delete: if false;
    }

    // ================= COMMENT REPORT =================
    match /commentReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != request.resource.data.toUid
        && request.resource.data.source == "comment"
        && request.resource.data.postId is string
        && request.resource.data.commentId is string
        && get(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)
        ).data.userId == request.resource.data.toUid;

      allow read, update, delete: if false;
    }

    // Admin-only operational projection. Mobile continues writing the
    // original report collections; Cloud Functions maintains these cases.
    match /reportCases/{caseId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

  }
}

