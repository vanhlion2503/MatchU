{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:feed": "node scripts/feed-seed/index.js",
    "seed:feed:dry-run": "node scripts/feed-seed/index.js --dry-run",
    "seed:feed:delete": "node scripts/feed-seed/index.js --delete-batch",
    "backfill:report-cases": "node scripts/backfill-report-cases.js",
    "test:feed-seed": "node --test test/feed-seed.test.js",
    "test:recommendation": "node --test test/recommendation-core.test.js",
    "test:post-search": "node --test test/post-search.test.js",
    "test:post-share": "node --test test/post-external-share.test.js",
    "test:post-text-moderation": "node --test test/post-text-moderation.test.js",
    "test:temp-chat": "node --test test/temp-chat-session.test.js",
    "test:temp-chat-moderation": "node --test test/temp-chat-moderation.test.js",
    "test:telepathy-insight": "node --test test/telepathy-insight.test.js",
    "test:notifications": "node --test test/chat-message-notifications.test.js",
    "test:chat-messages": "node --test test/chat-messages.test.js",
    "test:post-notifications": "node --test test/post-engagement-notifications.test.js",
    "test:account-security": "node --test test/account-security.test.js",
    "test:face-template-pin": "node --test test/face-template-update-pin.test.js",
    "test:chat-passcode": "node --test test/chat-passcode-security.test.js",
    "test:reputation": "node --test test/reputation-reward.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "@google/genai": "^1.37.0",
    "@huggingface/transformers": "^4.2.0",
    "axios": "^1.13.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
