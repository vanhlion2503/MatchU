{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:feed": "node scripts/feed-seed/index.js",
    "seed:feed:dry-run": "node scripts/feed-seed/index.js --dry-run",
    "seed:feed:delete": "node scripts/feed-seed/index.js --delete-batch",
    "test:feed-seed": "node --test test/feed-seed.test.js",
    "test:recommendation": "node --test test/recommendation-core.test.js",
    "test:temp-chat": "node --test test/temp-chat-session.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "@google/genai": "^1.37.0",
    "@huggingface/transformers": "^4.2.0",
    "axios": "^1.13.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
