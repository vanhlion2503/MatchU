<header class="admin-header"><button id="sidebarToggle" class="btn btn-light border" aria-label="Mở menu"><i class="bi bi-list"></i></button><a class="brand" href="/dashboard"><i class="bi bi-heart-fill"></i><span>MatchU Admin</span></a><div class="header-search d-none d-md-flex"><i class="bi bi-search"></i><input aria-label="Tìm kiếm" placeholder="Tìm kiếm (sắp ra mắt)" disabled></div><div class="ms-auto d-flex align-items-center gap-3"><button class="btn btn-light rounded-circle" aria-label="Thông báo"><i class="bi bi-bell"></i></button><div class="dropdown"><button class="btn p-0 border-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown"><span class="avatar"><%= (currentAdmin?.displayName || 'A').charAt(0).toUpperCase() %></span><span class="d-none d-sm-block text-start"><strong><%= currentAdmin?.displayName || 'Admin' %></strong><small><%= currentAdmin?.role || '' %></small></span></button><ul class="dropdown-menu dropdown-menu-end shadow border-0"><li><span class="dropdown-item-text small text-muted"><%= currentAdmin?.email || '' %></span></li><li><a class="dropdown-item disabled" href="#"><i class="bi bi-person me-2"></i>Hồ sơ (sắp ra mắt)</a></li><li><hr class="dropdown-divider"></li><li><form action="/auth/logout" method="post"><button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li></ul></div></div></header>
