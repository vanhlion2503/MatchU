<aside id="sidebar" class="admin-sidebar"><div class="sidebar-label">ĐIỀU HƯỚNG</div><nav><a class="nav-link <%= currentPath.startsWith('/dashboard') ? 'active' : '' %>" href="/dashboard"><i class="bi bi-grid-1x2"></i><span>Tổng quan</span></a><% if (hasPermission('users.read')) { %><a class="nav-link <%= currentPath.startsWith('/users') ? 'active' : '' %>" href="/users"><i class="bi bi-people"></i><span>Người dùng</span></a><% } %><% if (hasPermission('posts.read')) { %><a class="nav-link <%= currentPath.startsWith('/posts') ? 'active' : '' %>" href="/posts?queue=moderation"><i class="bi bi-file-post"></i><span>Bài viết</span><% if ((pendingPostModerationCount || 0) > 0) { %><strong class="sidebar-count-badge sidebar-post-badge" title="<%= pendingPostModerationCount %> bài viết cần kiểm duyệt" aria-label="<%= pendingPostModerationCount %> bài viết cần kiểm duyệt"><%= pendingPostModerationCount > 99 ? '99+' : pendingPostModerationCount %></strong><% } %></a><% } %><% if (hasPermission('reports.read')) { %><a class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>" href="/reports"><i class="bi bi-flag"></i><span>Quản lý báo cáo</span><% if ((pendingReportCount || 0) > 0) { %><strong class="sidebar-count-badge sidebar-report-badge" title="<%= pendingReportCount %> báo cáo đang chờ xử lý" aria-label="<%= pendingReportCount %> báo cáo đang chờ xử lý"><%= pendingReportCount > 99 ? '99+' : pendingReportCount %></strong><% } %></a><% } %><% if (hasPermission('notifications.read')) { %><a class="nav-link <%= currentPath.startsWith('/notifications') ? 'active' : '' %>" href="/notifications"><i class="bi bi-bell"></i><span>Thông báo</span></a><% } %><a class="nav-link" href="#"><i class="bi bi-stars"></i><span>Hệ thống đề xuất</span></a><% if (hasPermission('settings.read') || hasPermission('admins.manage') || hasPermission('audit_logs.read')) { %><div class="sidebar-label mt-3">HỆ THỐNG</div><% } %><% if (hasPermission('settings.read')) { %><a class="nav-link" href="#"><i class="bi bi-gear"></i><span>Cấu hình hệ thống</span></a><% } %><% if (hasPermission('admins.manage')) { %><a class="nav-link <%= currentPath.startsWith('/admins') ? 'active' : '' %>" href="/admins"><i class="bi bi-person-gear"></i><span>Quản lý admin</span></a><% } %><% if (hasPermission('audit_logs.read')) { %><a class="nav-link <%= currentPath.startsWith('/admin-logs') ? 'active' : '' %>" href="/admin-logs"><i class="bi bi-journal-text"></i><span>Nhật ký quản trị</span></a><% } %></nav></aside>
